# =============================================================================
# KIXINDE YA NGONGO — Variáveis de Ambiente
# Copie este ficheiro para .env.local e preencha os valores reais.
# No Vercel: Settings → Environment Variables
# =============================================================================

# --- Supabase (OBRIGATÓRIO) --------------------------------------------------
# URL do projecto Supabase (visível em: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service Role Key (secreta — NÃO expor ao cliente)
# Em: Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Email SMTP (OPCIONAL — necessário para envio de email) ------------------
# Servidor SMTP (ex: smtp.gmail.com, smtp.resend.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# Porta SMTP (587 para TLS, 465 para SSL, 25 para não-encriptado)
SMTP_PORT=587

# Usar SSL directo? (true para porta 465, false para 587 com STARTTLS)
SMTP_SECURE=false

# Email de envio (ex: geral@kixindeyangongo.ao ou conta Gmail)
SMTP_USER=geral@kixindeyangongo.ao

# Password da conta de email ou App Password (Gmail: conta → segurança → passwords de app)
SMTP_PASS=sua_password_aqui

# --- Inteligência Artificial (OPCIONAL — configurável via painel admin) ------
# Nota: a API key da IA é guardada no Supabase (tabela ai_config) via /admin/ai-config
# Estes valores são apenas para referência — configure pelo painel admin.

# Provider suportados: openai | anthropic | google
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-proj-...

# --- Aplicação ---------------------------------------------------------------
# URL de produção (necessário para redirects e links absolutos em emails)
NEXT_PUBLIC_APP_URL=https://kixindeyangongo.ao

# Ambiente (development | production)
NODE_ENV=production
